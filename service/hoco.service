[Unit]
Description=device Server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=pi
Group=pi
WorkingDirectory=/mnt/samba/deho/hoco

ExecStartPre=/bin/sleep 5
ExecStart=/mnt/samba/deho/hoco/.env/bin/python progs/hoco.py

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
